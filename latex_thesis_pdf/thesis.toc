\contentsline {section}{\numberline {4.6}An Updated Definition of Engagement}{112}{section.4.6}%
\contentsline {subsection}{\numberline {4.6.1}What the Results Teach Us}{112}{subsection.4.6.1}%
\contentsline {paragraph}{1. Staying is not engaging.}{113}{section*.20}%
\contentsline {paragraph}{2. Leaving is an event, and it has a physical signature.}{113}{section*.21}%
\contentsline {paragraph}{3. The realisation is individual; the construct is not.}{113}{section*.22}%
\contentsline {paragraph}{4. A measured quantity is undefined without a declared interval.}{113}{section*.23}%
\contentsline {paragraph}{5. Composites hide more than they summarise.}{114}{section*.24}%
