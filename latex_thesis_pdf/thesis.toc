\contentsline {section}{\numberline {4.6}An Updated Definition of Engagement}{109}{section.4.6}%
\contentsline {subsection}{\numberline {4.6.1}What the Results Teach Us}{109}{subsection.4.6.1}%
\contentsline {paragraph}{1. Staying is not engaging.}{110}{section*.20}%
\contentsline {paragraph}{2. Leaving is an event, and it has a physical signature.}{110}{section*.21}%
\contentsline {paragraph}{3. The realisation is individual; the construct is not.}{110}{section*.22}%
\contentsline {paragraph}{4. A measured quantity is undefined without a declared interval.}{110}{section*.23}%
\contentsline {paragraph}{5. Composites hide more than they summarise.}{111}{section*.24}%
