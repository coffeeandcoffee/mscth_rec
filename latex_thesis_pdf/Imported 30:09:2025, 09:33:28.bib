@report{morrison_impact_2024,
	title = {The Impact of Digital Storytelling on the Socio-emotional Development of Early Elementary Children},
	abstract = {Storytelling has been a central component of childhood education, facilitating cognitive and socio-emotional development through its use in various cultures and educational practices. The advent of digital technology has transformed traditional storytelling into digital storytelling, where multimedia elements enrich the narrative experience. This study explores the impact of digital storytelling on the socio-emotional development of early elementary children, focusing on emotional literacy, empathy, and social skills. Using a mixed-methods approach, the research examines how digital storytelling tools contribute to the development of key socio-emotional milestones, using case studies and observational logs. The findings suggest that digital storytelling enhances emotional expression, creativity, and interpersonal skills, while highlighting the challenges of integrating digital tools in early education. Digital storytelling not only engages young learners by integrating audio, visuals, and interactive elements but also offers unique opportunities for personalized learning. By catering to different learning styles, it allows children to experience narratives in a more immersive and engaging way, fostering a deeper emotional connection to the content. This enhanced engagement can lead to greater retention of lessons, as children are able to relate more personally to the stories they encounter. Moreover, digital storytelling encourages active participation, with children often involved in the creation of their own stories, which helps to develop critical thinking, problem-solving, and collaboration skills. However, as this study identifies, there are important considerations regarding the overuse of technology in educational settings, including the potential for distraction and the need for educators to be mindful of screen time and content appropriateness. Despite these challenges, digital storytelling presents a promising pedagogical tool that, when thoughtfully implemented, can significantly enrich the socio-emotional and cognitive development of early learners.},
	author = {Morrison, Kimona},
	date = {2024},
	keywords = {child development, cognitive development, Digital storytelling, early childhood education, educational tools, emotional literacy, empathy, multimedia learning, narrative learning, socio-emotional development, technology in education},
	file = {PDF:/Users/gregorlederer/Zotero/storage/DANEG4QP/0010_Morrison, 2024 (The Impact of Digital Storytelling on the Socio-emotional Development of Early Elementary Children ).pdf:application/pdf},
}

