@inproceedings{ercole_n2o-cooled_2017,
	title = {N2O-cooled aerospike for a hybrid rocket motor: Nitrous oxide characterization and additive manufacturing},
	isbn = {978-1-62410-511-1},
	doi = {10.2514/6.2017-4979},
	abstract = {This paper provides an overview of the progress accomplished in a research program that is addressing the development a N2O cooled spike nozzle for a hybrid rocket. The program is a collaboration between the Politecnico di Torino and Cal Poly San Luis Obispo. Two specific topics are presented here: the characterization of N2O behavior in the post dry-out regime (film cooling) and a new design of the cooling channels for the aerospike itself. Experimental tests using N2O in a Rayleigh tube apparatus were carried out and the data analysis to perform a preliminary evaluation of heat transfer coefficient in the post-dryout region is presented here. For the regeneratively-cooled aerospike, different coolant channel designs are proposed and analyzed. One geometry in particular, which exploits the advantages of modern additive manufacturing processes, was selected. A plastic prototype was manufactured as an exemplar.},
	booktitle = {53rd {AIAA}/{SAE}/{ASEE} Joint Propulsion Conference, 2017},
	publisher = {American Institute of Aeronautics and Astronautics Inc, {AIAA}},
	author = {Ercole, Giacomo and Garofalo, Erik and Maglie, Margherita Maria and Pastrone, Dario and Lemieux, Patrick},
	date = {2017},
}

@article{lemieux_nitrous_2010,
	title = {Nitrous oxide cooling in hybrid rocket nozzles},
	volume = {46},
	issn = {03760421},
	doi = {10.1016/j.paerosci.2009.12.001},
	abstract = {The Department of Mechanical Engineering at the California Polytechnic State University, San Luis Obispo, has developed an innovative program of experimental research and development on hybrid rocket motors (where the fuel and the oxidizer are in different phases prior to combustion). One project currently underway involves the development of aerospike nozzles for such motors. These nozzles, however, are even more susceptible to throat ablation than regular converging-diverging nozzles, due the nature of their flow expansion mechanism. This paper presents the result of a recent development project focused on reducing throat ablation in hybrid rocket motor nozzles. Although the method is specifically targeted at increasing the life and operating range of aerospike nozzles, this paper describes its proof-of-concept implementation on conventional nozzles. The method is based on a regenerative cooling mechanism that differs in practice from that used in liquid propellant motors. A series of experimental tests demonstrate that this new method is not only effective at reducing damage in the most ablative region of the nozzle, but that the nozzle can survive multiple test runs. © 2009 Elsevier Ltd. All rights reserved.},
	pages = {106--115},
	number = {2},
	journaltitle = {Progress in Aerospace Sciences},
	author = {Lemieux, Patrick},
	date = {2010-09},
}

