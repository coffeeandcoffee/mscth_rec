@article{fekih-romdhane_development_2025,
	title = {Development and Initial Validation of a Brief Measure of {TikTok} Addiction in a Multi-Country Sample},
	volume = {16},
	issn = {21501327},
	doi = {10.1177/21501319251352917},
	abstract = {Background: The dramatic increase in {TikTok} use over the past few years has generated a major challenge globally. Providing researchers with a valid, reliable, yet brief measure may stimulate large-scale epidemiological research that can help to clarify the mechanisms involved in susceptibility to {TikTok} addiction and guide the development of prevention strategies. The objective of our study was to design and validate a brief measure that we labelled the {TikTok} Addiction Test ({TAT}) using a multi-country sample, with a specific focus on measuring the 6 core features of addiction through 1 item each. Method: A multi-country survey with a cross-sectional design was conducted in February of 2025 among general population adults (N = 3362) from five Arab countries: Egypt, Jordan, Lebanon, Oman, and Palestine. Results: A single-factor solution was obtained in the Exploratory Factor Analysis and corroborated in the Confirmatory Factor Analysis, indicating an adequate goodness-of-fit indices, with all 6 items satisfactorily loading on the same latent variable. In addition, the internal consistency reliability indicators were excellent for the entire measure, with Cronbach’s alpha and {McDonald}’s omega values of 0.91. We found invariance in factor structure, factor loadings, and intercepts between sexes and for country groups. A total of 207 (6.2\%) participants were identified as {TikTok} addicts. Females exhibited significantly higher mean {TAT} scores than males. Palestinian and Lebanese participants reported the highest {TikTok} addiction scores, followed by Egyptians, Jordanians, and Omani. Finally, significant positive associations were observed between {TAT} scores and smartphone addiction, depression, anxiety, and loneliness, supporting the concurrent validity of the scale. Conclusion: Results suggest that the {TAT} is a simple and useful instrument for measuring {TikTok} addiction of general population adults with only 6 items and 1 factor. As a brief self-report measure, the {TAT} can be highly valuable in time- and resource-pressured real-life settings, and offers a foundation for future research in this area.},
	journaltitle = {Journal of Primary Care and Community Health},
	publisher = {{SAGE} Publications Inc.},
	author = {Fekih-Romdhane, Feten and Ali, Amira Mohammed and Shuwiekh, Hanaa Ahmed Mohamed and Helmy, Mai and Naser, Abdallah Y. and Jebreen, Kamel and El Khatib, Sami and Fawaz, Mirna and Swaitti, Tasnim and Radwan, Eqbal and Nawajah, Inad and Malaeb, Diana and Obeid, Sahar and Hallit, Souheil},
	date = {2025-01-01},
	keywords = {{TikTok} addiction, brief measure, psychometric evaluation, scale development, {TAT}},
	file = {PDF:/Users/gregorlederer/Zotero/storage/JQHMB37J/fekih-romdhane-et-al-2025-development-and-initial-validation-of-a-brief-measure-of-tiktok-addiction-in-a-multi-country.pdf:application/pdf},
}

@report{felix_psychological_nodate,
	title = {The Psychological and Neurological Effects of Digital Overstimulation and Dopamine Addiction Among Generation Z},
	abstract = {Generation Z (born 1997-2012) has grown up immersed in digital environments characterized by constant connectivity, algorithmic curation, and rapid information consumption. These conditions have given rise to phenomena such as digital overstimulation and dopamine addiction, which are increasingly linked to attention deficits, emotional dysregulation, and mental health decline. Drawing on recent empirical studies and theoretical frameworks, this paper explores how platforms like {TikTok} exploit cognitive vulnerabilities through reward-based engagement mechanisms, leading to long-term neurological and psychological consequences. Findings suggest that digital overstimulation disrupts executive control functions, reduces attention span, and exacerbates academic anxiety. This paper synthesizes literature from neuroscience, psychology, and media studies to assess these effects and outlines implications for educational practice and policy.},
	author = {Felix, Alvin},
	keywords = {{TikTok}, mental health, attention deficit, digital overstimulation, dopamine addiction, Gen Z},
	file = {PDF:/Users/gregorlederer/Zotero/storage/BW9HPKQI/ssrn-5348745.pdf:application/pdf},
}

@report{wade_investigating_2024,
	title = {Investigating brain responses in individuals with {TikTok} addiction, using Electroencephalogram ({EEG})},
	abstract = {{TikTok} addiction may be causing similar cognitive dysfunction to other highly researched addictions. Addiction is known to affect executive functions, particularly response inhibition. Evidence indicates that differences in N2/P3 amplitude/latency, and increased beta power (commonly found in individuals with addictions) may be causing impaired response inhibition, and overall cognitive performance. The current study aimed to fill the gap in {TikTok} addiction research using electroencephalogram ({EEG}) to investigate brain responses to 'Go' '{NoGo}' stimuli. 18 individuals participated in the study, 10 of whom had no history of addiction, and 8 with {TikTok} addiction. Using a between-subjects, repeated measures design, brain lateralisation differences were found in P3 latency during the 'Go' correct response condition in the F7/F8 electrodes F (1, 13) = 7.94 p = 0.015 η 2p = 0.38. Significant difference in beta power was found between the video and resting state conditions F (1, 13) = 5.24 p = 0.038 η 2p = 0.27. Results suggest that individuals with {TikTok} addiction may respond more impulsively, but there is no evidence to suggest that response inhibition is impaired. Results confirmed previous research, showing that brain activation in response to specific impulse related tasks is stronger in the right hemisphere. Findings suggest that {TikTok} addiction may be causing differences in brain responses, specifically in the frontal cortex which is directly involved with executive functions and cognitive performance.},
	author = {Wade, Callum},
	date = {2024},
	file = {PDF:/Users/gregorlederer/Zotero/storage/EC3XNUEY/TikTok EEG Research Study.pdf:application/pdf},
}

