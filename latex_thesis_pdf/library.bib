@techreport{seifert_entwurf_2020-1,
	title = {Entwurf eines {Kleinprüfstandes} für {Raketentriebwerke} mit den {Treibstoffen} {Wasserstoff} und {Sauerstoff}},
	abstract = {Entwurf eines Kleinprüfstandes für Raketentriebwerke mit den Treibstoffen Wasserstoff und Sauerstoff Thema: ILR­RFS GB 20­44 Maschinenwesen Luft­ und Raumfahrttechnik 3957015 Name des Studierenden: Matrikelnummer: Studiengang: Studienrichtung: Design of a test bench for small rocket engines using hydrogen and oxygen Subject: Motivation: Im Rahmen von Satellitentransportmissionen für Trägersysteme über den niedrigen Erdorbit hinaus treten signifikant lange Wartephasen während des Raumfluges auf. Dabei kommt es bei der Verwendung von kryogenen Treibstoffen zu starken Verlusten durch deren Verdampfen, insbesondere ohne aktives Treibstoffmanagement. Eine Variante für dieses Management ist die Nutzung von kleinen Schüben und somit einer künstlichen Mikrogravitation, um den Treibstoff am Tankboden zu sammeln und somit die benetzte Tankoberfläche zu minimieren. Um diesen Schub effektiv zu generieren, soll das anvisierte Triebwerk mit den Verlustgasen betrieben werden. Im Rahmen dieser Arbeit soll ein Prüfstand entwickelt werden, der eine experimentelle Erprobung solcher Triebwerke ermöglicht.},
	author = {Seifert, Lukas and Sieder-Katzmann, Jan and Propst, Martin},
	year = {2020},
}

@techreport{burkhardt_entwurf_2021-1,
	title = {Entwurf eines {Gasgenerators} für treibstoffreiche {Verbrennung} von gasförmigem {Wasserstoff} und {Sauerstoff}},
	abstract = {Maschinenwesen Luft-und Raumfahrttechnik 4540066 Name des Studierenden: Matrikelnummer: Studiengang: Studienrichtung: Design of a gas generator for fuelrich combustion with gaseous hydrogen and oxygen Subject: Motivation: Für den Betrieb von Hilfsaggregaten und Turbopumpen werden an Raketen meist zusätzliche Gasgeneratoren zur Energieversorgung verwendet. Dies geschieht unter der Verwendung brennstoffreicher Gemische der Raketentreibstoffe um eine hohe thermische Belastung der Generatoren zu vermeiden. Die Arbeitsgase werden dann zur Generierung von zusätzlichem Schub über Düsen entspannt. Im Rahmen dieser Arbeit ist ein fertigungsreifer Entwurf für einen Gasgenerator mit Wärmetauscher zur Temperatureinstellung der Arbeitsgase zu erarbeiten. Dieser soll für das Anmontieren von verschiedenen Düsen vorbereitet sein. Als Treibstoffe sind Wasserstoff (GH2) sowie Sauerstoff (GOX) vorgesehen.},
