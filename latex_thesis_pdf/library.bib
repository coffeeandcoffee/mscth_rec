@techreport{geetika_enhancing_2025-1,
	title = {Enhancing {Teen} {Cognitive} {Functions}: {The} {Synergistic} {Effects} of {AI}-{Generated} {Music} and {Storytelling} on {Memory} {Retention}},
	url = {https://www.hopkinsmedicine.org/health/wellness-and-prevention/keep-your-brain-},
	abstract = {In an increasingly hyper-digital world, adolescents are inundated with constant stimuli, resulting in reduced attention spans, impaired memory retention, and heightened emotional fatigue. Traditional pedagogical approaches often fail to meet the cognitive and emotional demands of Generation Z learners. This paper investigates the potential of artificial intelligence (AI)-generated music and storytelling, grounded in contemporary neuroscience, to enhance learning by engaging intrinsic neural mechanisms such as the hippocampus, prefrontal cortex, and amygdala. By leveraging neuroplasticity and emotional encoding, these AI-driven tools offer personalized and neurologically-aligned interventions. Emerging evidence demonstrates their effectiveness in improving memory, sustaining engagement, and boosting overall cognitive performance, signaling a transformative opportunity for the future of education in the digital era.},
	author = {Geetika, By},
	year = {2025},
}

