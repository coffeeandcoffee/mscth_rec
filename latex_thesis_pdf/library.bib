}

@article{su_viewing_2021,
	title = {Viewing personalized video clips recommended by {TikTok} activates default mode network and ventral tegmental area},
	volume = {237},
	issn = {10959572},
	doi = {10.1016/j.neuroimage.2021.118136},
	abstract = {Cutting-edge recommendation algorithms have been widely used by media platforms to suggest users with personalized content. While such user-specific recommendations may satisfy users’ needs to obtain intended information, some users may develop a problematic use pattern manifested by addiction-like undesired behaviors. Using a popular video sharing and recommending platform (TikTok) as an example, the present study first characterized use-related undesired behaviors with a questionnaire, then investigated how personally recommended videos modulated brain activity with an fMRI experiment. We found more undesired symptoms were related to lower self-control ability among young adults, and about 5.9\% of TikTok users may have significant problematic use. The fMRI results showed higher brain activations in sub-components of the default mode network (DMN), ventral tegmental area, and discrete regions including lateral prefrontal, anterior thalamus, and cerebellum when viewing personalized videos in contrast to non-personalized ones. Psychophysiological interaction analyses revealed stronger coupling between activated DMN subregions and neural pathways underlying auditory and visual processing, as well as the frontoparietal network. This study highlights the functional heterogeneity of DMN in viewing personalized videos and may shed light on the neural underpinnings of how recommendation algorithms are able to keep the user's attention to suggested contents.},
	journal = {NeuroImage},
	author = {Su, Conghui and Zhou, Hui and Gong, Liangyu and Teng, Binyu and Geng, Fengji and Hu, Yuzheng},
	month = aug,
	year = {2021},
	pmid = {33951514},
	note = {Publisher: Academic Press Inc.},
	keywords = {Default mode network, Personalized videos, Problematic TikTok use, Recommender system, Self-control, Ventral tegmental area},
	file = {PDF:/Users/gregorlederer/Zotero/storage/4FDRNITM/0022_Wang, 2021_(NeuroTikTok-Viewing personalized video clips recommended by TikTok activates default mode network and ventral tegmental area).pdf:application/pdf},
}

@article{kang_frontoparietal_2023,
	title = {Frontoparietal functional connectivity moderates the link between time spent on social media and subsequent negative affect in daily life},
	volume = {13},
	issn = {20452322},
	doi = {10.1038/s41598-023-46040-z},
	abstract = {Evidence on the harms and benefits of social media use is mixed, in part because the effects of social media on well-being depend on a variety of individual difference moderators. Here, we explored potential neural moderators of the link between time spent on social media and subsequent negative affect. We specifically focused on the strength of correlation among brain regions within the frontoparietal system, previously associated with the top-down cognitive control of attention and emotion. Participants (N = 54) underwent a resting state functional magnetic resonance imaging scan. Participants then completed 28 days of ecological momentary assessment and answered questions about social media use and negative affect, twice a day. Participants who spent more than their typical amount of time on social media since the previous time point reported feeling more negative at the present moment. This within-person temporal association between social media use and negative affect was mainly driven by individuals with lower resting state functional connectivity within the frontoparietal system. By contrast, time spent on social media did not predict subsequent affect for individuals with higher frontoparietal functional connectivity. Our results highlight the moderating role of individual functional neural connectivity in the relationship between social media and affect.},
	number = {1},
	journal = {Scientific Reports},
	author = {Kang, Yoona and Ahn, Jeesung and Cosme, Danielle and Mwilambwe-Tshilobo, Laetitia and McGowan, Amanda and Zhou, Dale and Boyd, Zachary M. and Jovanova, Mia and Stanoi, Ovidia and Mucha, Peter J. and Ochsner, Kevin N. and Bassett, Dani S. and Lydon-Staley, David and Falk, Emily B.},
	month = dec,
	year = {2023},
	pmid = {37993522},
	note = {Publisher: Nature Research},
	file = {PDF:/Users/gregorlederer/Zotero/storage/KIDY7DKU/brainrot-study-1.pdf:application/pdf},
}

@article{abedi_inconsistencies_nodate,
	title = {Inconsistencies in the {Definition} and {Annotation} of {Student} {Engagement} in {Virtual} {Learning} {Datasets}: {A} {Critical} {Review} {Inconsistencies} in {Measuring} {User} {Engagement} in {Virtual} {Learning}-{A} {Critical} {Review}},
	url = {https://www.researchgate.net/publication/353750667},
	doi = {10.13140/RG.2.2.11574.01601},
	abstract = {Virtual learning has surpassed the traditional boundaries of classroom teaching to telehealth, virtual rehabilitation and many other fields. One of the challenges in virtual learning is measuring the engagement of the learners, because it can have major impact on meeting their learning objectives and dropout risks in the program. There exist many measuring instruments for user engagement in virtual learning setting, many of them are specifically geared for student engagement. In this critical review, we analyze some of the recent student engagement datasets and highlight inconsistencies in terms of differing engagement definitions and measuring scales. We further discuss issues in terms of engagement annotations and design flaws, such as short questionnaire. One of the surprising findings was that none of the reviewed dataset on engagement detection used any existing psychometrically validated engagement scale in their analysis. Lastly, we mention some other user engagement scales that have the potential to be used in measuring engagement in virtual learning. We conclude this review with commentary on future of artificial intelligence approaches suitable for making progress in the field.},
	author = {Abedi, Ali and Khan, Shehroz S and Colella, Tracey J F},
	keywords = {Affect sensing and analysis, Artificial Intelligence, Computer vision, E-learning tools, Index Terms-Modeling from video},
	file = {PDF:/Users/gregorlederer/Zotero/storage/VINXTIS7/E0003_Khan,2023 (Student-engagement measures in virtual learning – critical review).pdf:application/pdf},
}

@article{darvin_design_2022,
	title = {Design, resistance and the performance of identity on {TikTok}},
	volume = {46},
	issn = {22116958},
	doi = {10.1016/j.dcm.2022.100591},
	abstract = {One of the most downloaded apps in the world, TikTok is known widely for its act-out memes and lip-sync videos, where music and sound clips are remixed among users. While most social media platforms serve as sites of self-presentation and identity management, embedded in TikTok's design is a memetic logic that encourages imitation and replication and downplays individual identities and social connections. By conducting a multimodal discourse analysis of videos produced by popular Hong Kong-based TikTokers, this paper demonstrates how these content creators were able to resist this memetic logic by finding ways to assert their Hongkonger identities and to forge a sense of community among fellow Hongkongers. Through the production of sound memes that use sound as an anchoring mode for producing derivative videos, these TikTokers foregrounded not only their embodied selves but also local spaces and languages. By formulating and promoting context-bound tracks that connected local users, they evoked a sense of pride and affinity among Hongkongers. As content creators produce videos on TikTok, the interplay of platform affordances and constraints can be understood as a negotiation of designs: the platform design which indexes the sociotechnical purposes of app developers and software engineers and the user design which involves the assembly of semiotic resources that enable users to achieve their own intentions. Recognizing the capacity of social media platforms to program sociality, this paper asserts the need for research methods that examine the tension between the structuring power of these platforms and the agentive participation of users.},
	journal = {Discourse, Context and Media},
	author = {Darvin, Ron},
	month = apr,
	year = {2022},
	note = {Publisher: Elsevier B.V.},
	keywords = {Design, Identity, Memes, Multimodal discourse analysis, Resistance, TikTok},
	file = {PDF:/Users/gregorlederer/Zotero/storage/XH29N852/0021_Darvin, 2022_(TikTok Algorithm adapts in real time).pdf:application/pdf},
}

@article{he_brain_2017,
	title = {Brain anatomy alterations associated with {Social} {Networking} {Site} ({SNS}) addiction},
	volume = {7},
	issn = {20452322},
	doi = {10.1038/srep45064},
	abstract = {This study relies on knowledge regarding the neuroplasticity of dual-system components that govern addiction and excessive behavior and suggests that alterations in the grey matter volumes, i.e., brain morphology, of specific regions of interest are associated with technology-related addictions. Using voxel based morphometry (VBM) applied to structural Magnetic Resonance Imaging (MRI) scans of twenty social network site (SNS) users with varying degrees of SNS addiction, we show that SNS addiction is associated with a presumably more efficient impulsive brain system, manifested through reduced grey matter volumes in the amygdala bilaterally (but not with structural differences in the Nucleus Accumbens). In this regard, SNS addiction is similar in terms of brain anatomy alterations to other (substance, gambling etc.) addictions. We also show that in contrast to other addictions in which the anterior-/mid-cingulate cortex is impaired and fails to support the needed inhibition, which manifests through reduced grey matter volumes, this region is presumed to be healthy in our sample and its grey matter volume is positively correlated with one's level of SNS addiction. These findings portray an anatomical morphology model of SNS addiction and point to brain morphology similarities and differences between technology addictions and substance and gambling addictions.},
	journal = {Scientific Reports},
	author = {He, Qinghua and Turel, Ofir and Bechara, Antoine},
	month = mar,
	year = {2017},
	pmid = {28332625},
	note = {Publisher: Nature Publishing Group},
	file = {PDF:/Users/gregorlederer/Zotero/storage/FHAXYBFA/brainrot-study-2.pdf:application/pdf},
}

@article{zhang_how_2025,
