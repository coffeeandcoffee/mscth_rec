# =============================================================================
# EEG TikTok Study - Git Ignore
# =============================================================================

# -----------------------------------------------------------------------------
# Data & Recordings (large video files only - other files like .csv, .png, .pt, .npz are synced)
# -----------------------------------------------------------------------------
# Video files in recordings (large files)
recordings/**/*.mp4
recordings/**/*.avi
recordings/**/*.mov
recordings/**/*.mkv
recordings/**/*.webm
recordings/**/*.MP4
recordings/**/*.AVI
recordings/**/*.MOV

# Entire data folder
data/

# -----------------------------------------------------------------------------
# Python Virtual Environments
# -----------------------------------------------------------------------------
mscth/
venv/
.venv/
env/
.env/

# -----------------------------------------------------------------------------
# Python Cache & Bytecode
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# -----------------------------------------------------------------------------
# Jupyter Notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# IDE & Editor Settings
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# macOS System Files
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# -----------------------------------------------------------------------------
# Deprecated/Archive Folders
# -----------------------------------------------------------------------------
old_delete/

# -----------------------------------------------------------------------------
# Serialized Data (large, regenerable)
# -----------------------------------------------------------------------------
*.pkl

# -----------------------------------------------------------------------------
# Logs & Temporary Files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp

# -----------------------------------------------------------------------------
# Distribution / Packaging
# -----------------------------------------------------------------------------
dist/
build/
*.egg-info/
*.egg
# Large skip labels CSVs (regenerate with post2v2_add_skip_classification.py)
*_skip_labels_*.csv

# EEG Pipeline Run Outputs - Ultra-Strict Smart Tracking
# -----------------------------------------------------------------------------
# 1. Ignore everything in the runs directory
05-12_data_analysis_and_results/runs/*
runs/*

# 2. Allow Git to traverse into the timestamped run folders
!05-12_data_analysis_and_results/runs/*/
!runs/*/

# 3. Ignore all files and folders immediately inside the timestamped run folders
05-12_data_analysis_and_results/runs/*/*
runs/*/*

# 4. Allow Git to traverse into the specific folders we want to track
!05-12_data_analysis_and_results/runs/*/viz/
!05-12_data_analysis_and_results/runs/*/grid_search/
!runs/*/viz/
!runs/*/grid_search/

# 5. Explicitly TRACK the contents of those folders (ML models/params & Vizes)
!05-12_data_analysis_and_results/runs/*/viz/*
!05-12_data_analysis_and_results/runs/*/grid_search/*
!runs/*/viz/*
!runs/*/grid_search/*

# 6. Explicitly TRACK the essential raw final data files
!05-12_data_analysis_and_results/runs/*/parameters.json
!05-12_data_analysis_and_results/runs/*/best_combinations.json
!05-12_data_analysis_and_results/runs/*/parallel_universe_metrics.csv
!05-12_data_analysis_and_results/runs/*/parallel_universe_comparisons.csv
!05-12_data_analysis_and_results/runs/*/*_parallel_recalls.pkl
!runs/*/parameters.json
!runs/*/best_combinations.json
!runs/*/parallel_universe_metrics.csv
!runs/*/parallel_universe_comparisons.csv
!runs/*/*_parallel_recalls.pkl

